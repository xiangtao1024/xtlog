# ---- 构建产物 ----
target/

# ---- 客户端（Rust 子项目）----
client/target/
# 客户端状态文件（相对路径运行时落在 cwd，避免污染仓库）
xtlog-client.state
*.state

# ---- 前端 ----
web/node_modules/
web/dist/

# ---- 部署包产出（scripts\build-dist.* 生成）----
# 默认全忽略；唯独发布 zip 特意入库，供别人 clone 后解压即用（不依赖源码构建）
# *.zip.tmp / *.zip.old / *.tar.gz / 解压目录 仍被忽略
dist/*
!dist/xtlog-server-*.zip

# ---- 运行期数据（SQLite 库、WAL 日志）----
data/

# ---- 诊断 / 临时文件 ----
# 注意：沙箱的 safe-delete 钩子会拦截删除，这些临时产物只能靠忽略来保持仓库干净
_*.log
_*.txt
_*.json
_*.java
pic-*.png
fix-*.png
